import java.util.ArrayList; // Import ArrayList
import java.util.Scanner;   // Import Scanner

public class OddEvenArrays {

	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in); // Create a Scanner object for input

		// 1. Get an integer input from the user
		System.out.print("Enter a natural number: ");
		int number;

		try {
			number = scanner.nextInt(); // Read the integer input
		} catch (java.util.InputMismatchException e) {
			System.err.println("Invalid input. Please enter an integer.");
			scanner.close(); // Close the scanner before exiting
			return; // Exit the program
		}

		// Check for a Natural Number. If not a natural number, then print an error and exit the program
		if (number <= 0) {
			System.err.println("Error: Please enter a natural number (a positive integer).");
			scanner.close(); // Close the scanner before exiting
			return; // Exit the program
		}

		// 2. Create ArrayLists for even and odd numbers
		// ArrayLists automatically handle resizing, making them easier to use when the exact number
		// of elements isn't known beforehand.
		ArrayList<Integer> oddNumbers = new ArrayList<>();
		ArrayList<Integer> evenNumbers = new ArrayList<>();

		// 3. Using a for loop, iterate from 1 to the number
		for (int i = 1; i <= number; i++) {
			// In each iteration of the loop, add the odd or even number into the corresponding ArrayList
			if (i % 2 == 0) { // Check if the number is even
				evenNumbers.add(i); // Add to the evenNumbers ArrayList
			} else { // The number is odd
				oddNumbers.add(i); // Add to the oddNumbers ArrayList
			}
		}

		// 4. Finally, print the odd and even numbers ArrayLists
		// ArrayLists have a convenient toString() method for printing their contents directly.
		System.out.println("\nOdd Numbers: " + oddNumbers.toString());
		System.out.println("Even Numbers: " + evenNumbers.toString());

		scanner.close(); // Close the scanner to prevent resource leaks
	}
}
