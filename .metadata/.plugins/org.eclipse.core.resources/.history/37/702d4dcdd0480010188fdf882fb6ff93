package ControlFlow;

public class LargestOfTheThree {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int num1;
		int num2;
		int num3;
		int largestnumber;
		if (num1>num2 && num1 >num3) {
			largestnumber = num1;
		}
		else if (num2>num3 && num2 > num1 ) {
			largestnumber = num2;
		}
		else {
			largestnumber = num3;
		}
		System.out.println(largestnumber);

	}

}
