package ClassAndObjects;

class MovieTicket{
	
	private String movieName;
	private String seatNumber;
	private double price;
	private boolean isBooked;
	
	
	public MovieTicket(String movieName) {
		this.movieName = movieName;
		this.seatNumber = "N/A";
		this.price = 0.0;
		this.isBooked = false;
	}
	
	
	
	public boolean bookTicket(String seatNumber, double price) {
		if(this.isBooked) {
			System.out.println("this ticket is already booked for movie-" + movieName);
			return false;
		}
		
		if(price <=0) {
			System.out.println("negative money?");
			return false;
		}
		
		this.seatNumber = seatNumber;
		this.price = price;
		this.isBooked = true;
		System.out.println("this is book sucessfully for movie-" + movieName);
		return true;	
	}
	
	public void displayDetails() {
		System.out.println("moive" + movieName);
		System.out.println("seat number" + seatNumber);
		System.out.println("price" + String.format("%.2f", price));
		System.out.println("status" + (isBooked ? "booked" : "available(not booked yet)"));

	}
	
	
}



public class MovieTicketBookingSystem {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		 MovieTicket ticket1 = new MovieTicket("Inception");

	        ticket1.displayTicketDetails();

	        // Book the first ticket
	        ticket1.bookTicket("A5", 15.50);
	        ticket1.displayTicketDetails();

	        // Attempt to book the same ticket again (should fail)
	        System.out.println("\n--- Attempting to re-book ticket1 ---");
	        ticket1.bookTicket("B7", 12.00); // This should show an error
	        ticket1.displayTicketDetails(); // Details should remain the same

	        // Create another ticket for a different movie
	        MovieTicket ticket2 = new MovieTicket("The Matrix");
	        ticket2.displayTicketDetails(); // Initial state

	        // Book the second ticket
	        ticket2.bookTicket("C10", 18.00);
	        ticket2.displayTicketDetails();

	        // Create a ticket and try to book with invalid price
	        MovieTicket ticket3 = new MovieTicket("Interstellar");
	        System.out.println("\n--- Attempting to book ticket3 with invalid price ---");
	        ticket3.bookTicket("D1", -5.00); // Should fail due to negative price
	        ticket3.displayTicketDetails();
		
		
		
		
	}

}
