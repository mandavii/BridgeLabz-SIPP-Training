package CoreJavaMethods;

import java.util.Scanner;

public class WindChillTemperature {
	
	public static double calculateWindChill(double temp, double speed) {
		
		double windChill = 35.74 +(0.6215 * temp) + ((0.4275 *temp - 35.75) *Math.pow(speed,  0.16));
		return windChill;
	}

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		double temp2;
		double speed2;
		
		Scanner input = new Scanner(System.in);
		
		temp2 = input.nextDouble();
		speed2 = input.nextDouble();
		
		double windChill2 = calculateWindChill(temp2, speed2);
		
		System.out.println(windChill2);

		input.close();
	}

}
