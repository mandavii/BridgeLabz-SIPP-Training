package ClassAndObjects;

class MovieTicket{

	private String movieName;
	private String seatNumber;
	private double price;
	private boolean isBooked;


	// FIX 1: Corrected typo 'publice' to 'public'
	public MovieTicket(String movieName) {
		this.movieName = movieName;
		this.seatNumber = "N/A";
		this.price = 0.0;
		this.isBooked = false;
	}


	// FIX 2: Corrected typo 'bookeTicket' to 'bookTicket'
	public boolean bookTicket(String seatNumber, double price) {
		if(this.isBooked) {
			System.out.println("Error: This ticket is already booked for movie - " + movieName); // Improved message
			return false;
		}

		if(price <=0) {
			System.out.println("Error: Ticket price must be positive."); // Improved message
			return false;
		}

		this.seatNumber = seatNumber;
		this.price = price;
		this.isBooked = true;
		System.out.println("Success: Ticket booked successfully for movie - " + movieName); // Improved message
		return true;
	}

	public void displayDetails() {
		// Minor readability improvements in print statements
		System.out.println("\n--- Movie Ticket Details ---"); // Added header
		System.out.println("Movie: " + movieName);
		System.out.println("Seat Number: " + seatNumber);
		System.out.println("Price: $" + String.format("%.2f", price));
		System.out.println("Status: " + (isBooked ? "BOOKED" : "AVAILABLE (Not Booked Yet)")); // Clarified status
		System.out.println("----------------------------"); // Added footer
	}
}


public class MovieTicketBookingSystem {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		 MovieTicket ticket1 = new MovieTicket("Inception");

		// FIX 3: Changed displayTicketDetails() to displayDetails()
	        ticket1.displayDetails();

	        // Book the first ticket
	        ticket1.bookTicket("A5", 15.50);
	        ticket1.displayDetails(); // FIX 3: Changed displayTicketDetails() to displayDetails()

	        // Attempt to book the same ticket again (should fail)
	        System.out.println("\n--- Attempting to re-book ticket1 ---");
	        ticket1.bookTicket("B7", 12.00); // This should show an error
	        ticket1.displayDetails(); // FIX 3: Changed displayTicketDetails() to displayDetails()

	        // Create another ticket for a different movie
	        MovieTicket ticket2 = new MovieTicket("The Matrix");
	        ticket2.displayDetails(); // FIX 3: Changed displayTicketDetails() to displayDetails() // Initial state

	        // Book the second ticket
	        ticket2.bookTicket("C10", 18.00);
	        ticket2.displayDetails(); // FIX 3: Changed displayTicketDetails() to displayDetails()

	        // Create a ticket and try to book with invalid price
	        MovieTicket ticket3 = new MovieTicket("Interstellar");
