package ControlFlow;

import java.util.Scanner;

public class WhileLoopSumAndComparisionOfnNaturalNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		Scanner input = new Scanner(System.in);
		int n = input.nextInt();
		
		if(n<=0) {
			System.out.println("Not Natural");
		}
		else {
			long sumWhileLoop = 0;
			int i = 0;
			while( i <=n) {
				sumWhileLoop +=i;
				i++;
			}
			System.out.println(sumWhileLoop);
			
		
		
		long SumFormula = (long)  n*(n+1)/2; 
		System.out.println(SumFormula);
		
		if(sumWhileLoop == SumFormula) {
			System.out.println("matched");
		}
		else {
			System.out.println("not natched");
		}
		
		}
		input.close();
	}

}
