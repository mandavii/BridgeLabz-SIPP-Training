package ControlFlow;

import java.util.Scanner;

public class SumAndComparisionOfnNaturalNumber {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		long sumForLoop;
		Scanner input = new Scanner(System.in);
		int n = input.nextInt();
		
		if(n<=0) {
			System.out.println("Not Natural");
		}
		else {
			 sumForLoop = 0;
			for(int i = 1; i <=n; i++) {
				sumForLoop +=i;
			}
			System.out.println(sumForLoop);
			
		}
		
		long SumFormula = (long)  n*(n+1)/2; 
		System.out.println(SumFormula);
		
		if (sumForLoop == SumFormula) {
			System.out.println("matched");
		}
		else {
			System.out.println('not natched');
		}
		
		
		input.close();

		 
		 
	}

}
